# Copy this file to .env and fill in real values.

# --- Server ---
PORT=8080
APP_BASE_URL=http://localhost:8080

# --- Database (either DATABASE_URL, or the individual DB_* vars below) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salestrack?sslmode=disable
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salestrack
DB_SSLMODE=disable

# --- Auth ---
# Any long random string. Rotate this and every issued token becomes invalid.
JWT_SECRET=change-me-to-a-long-random-string

# --- Razorpay (UPI payments on bill approval) ---
# From https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Webhooks section of the Razorpay dashboard, when you add the
# /api/payments/razorpay/webhook URL as a webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=
